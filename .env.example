# === TrappistCode IDE - Local First ===
# Pas de clé API requise pour l'agent principal.

# Le backend IDE tourne sur localhost:4269
PORT=4269

# Dossier workspace par défaut (facultatif)
TRAPPIST_WORKSPACE=/path/to/your/projects

# Le serveur d'agents Ollama (ton repo TrappistCode) est attendu sur :
# http://localhost:8000/ask
# Lance-le avec : python server.py

# Optionnel : token GitHub UNIQUEMENT pour commit/push/pull sur tes repos privés
# VITE_GITHUB_TOKEN=ghp_xxx
